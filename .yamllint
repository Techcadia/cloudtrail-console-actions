---
# yamllint config for the policy YAML (internal/policy/default.yaml).
extends: default

rules:
  # Single-line conditions are written `{ key: ..., operator: ..., value: ... }`
  # with one space inside the braces.
  braces:
    min-spaces-inside: 1
    max-spaces-inside: 1
  line-length:
    max: 120
